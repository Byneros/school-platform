PORT=4003
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/school_platform"
JWT_SECRET="change_me_use_a_long_random_secret"
JWT_EXPIRES_IN="8h"

REDIS_URL="redis://localhost:6379"
REDIS_CACHE_TTL_SECONDS=300
REDIS_CACHE_TTL_CRITICAL=600
REDIS_CACHE_TTL_SUGGESTIONS=120
REDIS_CACHE_TTL_CLASSES=3600
REDIS_CACHE_TTL_PARENT=300
REDIS_CACHE_EXCLUDE_PATHS="/api/auth,/api/reports/export,/api/notifications/export,/api/certificates/export"
REDIS_CACHE_LOG_EVERY=25

CORS_ORIGINS="http://127.0.0.1:5173,http://localhost:5173"
JSON_BODY_LIMIT="15mb"
TRUST_PROXY=false

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=8
LOGIN_LOCKOUT_WINDOW_MS=900000
LOGIN_LOCKOUT_MAX=5
LOGIN_LOCKOUT_BLOCK_MS=900000
TWO_FACTOR_RATE_LIMIT_WINDOW_MS=600000
TWO_FACTOR_RATE_LIMIT_MAX=10
WRITE_RATE_LIMIT_WINDOW_MS=60000
WRITE_RATE_LIMIT_MAX=120
NOTIFICATIONS_RATE_LIMIT_WINDOW_MS=60000
NOTIFICATIONS_RATE_LIMIT_MAX=60
REPORTS_RATE_LIMIT_WINDOW_MS=60000
REPORTS_RATE_LIMIT_MAX=30

ADMIN_2FA_ENABLED=false
TWO_FACTOR_ROLES="ADMIN,TEACHER,PARENT"
ADMIN_2FA_CODE_TTL_MS=600000
ADMIN_2FA_MAX_ATTEMPTS=5
ADMIN_2FA_RESEND_COOLDOWN_MS=60000
ADMIN_2FA_CODE_SECRET="change_me_use_a_long_random_secret"

SCHOOL_NAME="Colegio Demo"
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Colegio <no-reply@colegio.edu>"

NOTIFICATION_WORKER_ENABLED=false
EMAIL_WORKER_ENABLED=false
CACHE_WARM_WORKER_ENABLED=false
QUEUE_ATTEMPTS=3
QUEUE_BACKOFF_MS=5000
EMAIL_QUEUE_2FA=false

ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_PEPPER="change_me_use_a_long_random_secret"
REFRESH_COOKIE_NAME="school_refresh"

IP_GEO_ENABLED=false
IP_GEO_ENDPOINT="https://ipapi.co/{ip}/json/"
IP_GEO_TIMEOUT_MS=800

CACHE_METRICS_TOKEN="change_me"
CACHE_WARM_ENABLED=false
CACHE_WARM_BASE_URL=""
CACHE_WARM_TOKEN=""
CACHE_WARM_TIMEOUT_MS=4000
RATE_LIMIT_METRICS_TOKEN="change_me"
