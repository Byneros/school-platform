# =========================
# School Platform - Produccion
# Copia este archivo a:
#   infra/.env.production
# o a:
#   infra/.env.production.<colegio>
# =========================

SCHOOL_NAME=Colegio Demo

# Puerto publico del frontend (nginx web)
WEB_PORT=8080

# API URL compilada para frontend.
# En docker-compose.prod se usa nginx reverse-proxy /api.
VITE_API_URL=/api

# JWT
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_LARGO_Y_UNICO
JWT_EXPIRES_IN=8h
REFRESH_TOKEN_PEPPER=CAMBIAR_POR_OTRO_SECRETO_LARGO_Y_UNICO

# HTTP / CORS
CORS_ORIGINS=https://tu-dominio.edu.co
TRUST_PROXY=true

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=school_platform

# Workers
NOTIFICATION_WORKER_ENABLED=true
EMAIL_WORKER_ENABLED=true

# SMTP
SMTP_HOST=smtp.tuproveedor.com
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Colegio <no-reply@colegio.edu>
