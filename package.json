{
  "name": "school-platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "dev:web:lan": "powershell -ExecutionPolicy Bypass -File ./scripts/dev-web-lan.ps1 -Port 5173",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:all": "powershell -ExecutionPolicy Bypass -File ./scripts/dev-all.ps1",
    "build": "npm --workspace apps/web run build && npm --workspace apps/api run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "npm --workspace apps/api run typecheck && npm --workspace apps/web run typecheck",
    "verify": "npm run lint && npm run typecheck && npm run build",
    "test:api": "npm --workspace apps/api run test",
    "test:api:regression": "npm --workspace apps/api run test:regression",
    "db:backup": "node ./scripts/db/backup.mjs",
    "db:restore": "node ./scripts/db/restore.mjs",
    "start:api": "npm --workspace apps/api run start",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:ps": "docker compose -f infra/docker-compose.yml ps",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f --tail=200",
    "prisma:generate": "npm --workspace apps/api run prisma:generate",
    "prisma:migrate": "npm --workspace apps/api run prisma:migrate",
    "prisma:migrate:deploy": "npm --workspace apps/api run prisma:migrate:deploy",
    "prisma:backfill": "npm --workspace apps/api run prisma:backfill",
    "prisma:migrate:full": "npm --workspace apps/api run prisma:migrate:full",
    "prisma:seed": "npm --workspace apps/api run prisma:seed",
    "prisma:seed:qa": "npm --workspace apps/api run prisma:seed:qa",
    "ready": "node ./scripts/health-check.mjs",
    "preprod:verify": "node ./scripts/preprod-verify.mjs",
    "ops:health": "node ./scripts/health-check.mjs",
    "render:api:build": "npm --workspace apps/api run build",
    "render:api:start": "npm --workspace apps/api run prisma:migrate:deploy && npm --workspace apps/api run start",
    "render:web:build": "npm --workspace apps/web run build",
    "nginx:generate:multi": "node ./scripts/generate-nginx-multi.mjs",
    "certbot:multi:plan": "node ./scripts/certbot-multi.mjs --mode issue --email admin@tudominio.com",
    "certbot:multi:issue": "node ./scripts/certbot-multi.mjs --mode issue --email admin@tudominio.com --execute",
    "certbot:multi:renew": "node ./scripts/certbot-multi.mjs --mode renew --execute",
    "certbot:multi:renew:dryrun": "node ./scripts/certbot-multi.mjs --mode renew-dry-run --execute",
    "bootstrap:multi:plan": "node ./scripts/bootstrap-multi-schools.mjs --config infra/bootstrap/schools-batch.json",
    "bootstrap:multi:run": "node ./scripts/bootstrap-multi-schools.mjs --config infra/bootstrap/schools-batch.json --execute",
    "pm2:start": "npx pm2 start ecosystem.config.cjs --env production",
    "pm2:restart": "npx pm2 restart ecosystem.config.cjs --env production",
    "pm2:stop": "npx pm2 stop ecosystem.config.cjs",
    "pm2:delete": "npx pm2 delete ecosystem.config.cjs",
    "pm2:status": "npx pm2 status",
    "pm2:logs": "npx pm2 logs --lines 200",
    "pm2:save": "npx pm2 save",
    "pm2:startup": "npx pm2 startup",
    "doctor": "npx react-doctor@latest",
    "prepare": "node .husky/install.mjs"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --cache",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,scss}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^9.39.5",
    "@types/node": "^25.2.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.0.1",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.5",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.64.0"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "ioredis": "^5.10.1"
  }
}
